{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["server", "shared"],
  "exclude": ["server/**/*.test.ts", "shared/**/*.test.ts"]
}
